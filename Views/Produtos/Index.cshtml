@model IEnumerable<ProdutosApp.Models.Produto>

@{
    string ProximaDirecao(string coluna)
        => (string)ViewData["CurrentSort"] == coluna && (string)ViewData["CurrentDirection"] == "asc"
            ? "desc" : "asc";

    string Seta(string coluna)
    {
        if ((string)ViewData["CurrentSort"] != coluna) return "";
        return (string)ViewData["CurrentDirection"] == "asc" ? " ▲" : " ▼";
    }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Produtos</h1>
    <form asp-action="Index" method="get" class="row g-2 mb-3">
        <input type="hidden" name="sortColumn" value="@ViewData["CurrentSort"]" />
        <input type="hidden" name="sortDirection" value="@ViewData["CurrentDirection"]" />

        <div class="col-auto">
            <input type="text" name="filtroDescricao" value="@ViewData["FiltroDescricao"]"
                   class="form-control" placeholder="Filtrar por descrição" />
        </div>
        <div class="col-auto">
            <input type="text" name="filtroUsuario" value="@ViewData["FiltroUsuario"]"
                   class="form-control" placeholder="Filtrar por usuário" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Filtrar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpar</a>
        </div>
    </form>
    <a asp-action="Create" class="btn btn-primary">+ Novo Produto</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>
                <a asp-action="Index" asp-route-sortColumn="Id" asp-route-sortDirection="@ProximaDirecao("Id")" class="text-decoration-none">
                    ID@Seta("Id")
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortColumn="DataCadastro" asp-route-sortDirection="@ProximaDirecao("DataCadastro")" class="text-decoration-none">
                    Data de Cadastro@Seta("DataCadastro")
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortColumn="UsuarioCadastro" asp-route-sortDirection="@ProximaDirecao("UsuarioCadastro")" class="text-decoration-none">
                    Usuário@Seta("UsuarioCadastro")
                </a>
            </th>
            <th>Descrição</th>
            <th>
                <a asp-action="Index" asp-route-sortColumn="Valor" asp-route-sortDirection="@ProximaDirecao("Valor")" class="text-decoration-none">
                    Valor@Seta("Valor")
                </a>
            </th>
            <th>Quantidade</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var produto in Model)
        {
            <tr>
                <td>@produto.Id</td>
                <td>@produto.DataCadastro.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@produto.UsuarioCadastro</td>
                <td>@produto.Descricao</td>
                <td>@produto.Quantidade</td>
                <td>@produto.Valor.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@produto.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                    <a asp-action="Edit" asp-route-id="@produto.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@produto.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">Nenhum produto cadastrado ainda.</p>
}